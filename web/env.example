# Alpha Vantage API Key
# Ottieni la tua API key gratuita su: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Secret Key per Flask (cambia in produzione)
SECRET_KEY=your_secret_key_here

# Database PostgreSQL (opzionale - usa i valori di default se non specificato)
DATABASE_URL=postgresql://dollarpunk_user:dollarpunk_password@postgres:5432/dollarpunk
